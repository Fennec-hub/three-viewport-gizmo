{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@lib/*": ["./lib/*"]
    }
  },
  "files": [
    "lib/__tests__/publicSurface.types.test.ts",
    "lib/__tests__/ViewportGizmo.events.test.ts",
    "lib/controls/contract.test.ts"
  ],
  "include": ["lib/**/*.ts"],
  "exclude": ["lib/**/*.test.ts", "lib/__tests__/**"]
}
