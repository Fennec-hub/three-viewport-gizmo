{
  "name": "@taulabs/three-viewport-gizmo",
  "description": "Tau-maintained Three.js viewport gizmo with WebGL and WebGPU support.",
  "author": "Fennec",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/three-viewport-gizmo.umd.cjs",
  "module": "./dist/three-viewport-gizmo.js",
  "exports": {
    ".": {
      "import": "./dist/three-viewport-gizmo.js",
      "require": "./dist/three-viewport-gizmo.umd.cjs"
    }
  },
  "version": "2.2.4",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.9",
    "smol-toml": "1.8.0",
    "vite": "$vite"
  },
  "types": "./dist/three-viewport-gizmo.d.ts",
  "scripts": {
    "dev": "vite serve --config=vite.live.config.js",
    "build": "tsc && vite build ",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:live": "tsc && vite build --config=vite.live.config.js",
    "preview": "vite preview --config=vite.live.config.js",
    "docs:dev": "npm run build && vitepress dev docs",
    "docs:build": "npm run build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "quality": "npm test && npm run typecheck && npm run docs:build && npm audit --audit-level=high && npm run test:release",
    "plan:check": "nx release plan:check",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@nx/js": "23.1.1",
    "@rollup/plugin-commonjs": "28.0.6",
    "@types/node": "^20.11.28",
    "@types/three": "0.184.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "camera-controls": "3.1.2",
    "jsdom": "26.1.0",
    "nx": "23.1.1",
    "oh-vue-icons": "^1.0.0-rc3",
    "semver": "7.8.5",
    "three": "0.184.0",
    "typescript": "5.9.3",
    "utility-types": "^3.11.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "4.5.4",
    "vitepress": "1.6.4",
    "vitest": "3.2.7",
    "vue": "3.5.21"
  },
  "peerDependencies": {
    "three": ">=0.162.0 <1.0.0"
  },
  "keywords": [
    "three.js",
    "viewport",
    "gizmo",
    "helper",
    "3d",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/three-viewport-gizmo.git"
  },
  "bugs": {
    "url": "https://github.com/taucad/three-viewport-gizmo/issues"
  },
  "homepage": "https://github.com/taucad/three-viewport-gizmo#readme",
  "allowScripts": {
    "esbuild@0.25.0": true,
    "nx@23.1.1": true,
    "vue-demi@0.12.5": true,
    "fsevents@2.3.3": true
  }
}
