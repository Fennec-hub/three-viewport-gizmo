{
  "name": "@taulabs/three-viewport-gizmo",
  "description": "Tau-maintained Three.js viewport gizmo with WebGL and WebGPU support.",
  "author": "Richard Fontein",
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/three-viewport-gizmo.d.ts",
      "default": "./dist/three-viewport-gizmo.js"
    },
    "./camera-controls": {
      "types": "./dist/camera-controls.d.ts",
      "default": "./dist/camera-controls.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/three-viewport-gizmo.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "version": "3.0.0-beta.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.13",
    "undici": "7.30.2",
    "vite": "$vite"
  },
  "scripts": {
    "dev": "next dev site",
    "build": "tsc && vite build ",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "docs:dev": "next dev site",
    "docs:build": "npm run build && next build site",
    "quality": "npm test && npm run typecheck && npm run docs:build && npm audit --audit-level=high && npm run test:release",
    "plan:check": "nx release plan:check",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@nx/js": "23.3.2",
    "@playwright/test": "1.64.0",
    "@types/node": "^20.11.28",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "4.1.12",
    "camera-controls": "3.1.2",
    "jsdom": "26.1.0",
    "next": "16.4.6",
    "nx": "23.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "shiki": "4.6.0",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "camera-controls": "^3.0.0",
    "three": ">=0.167.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "camera-controls": {
      "optional": true
    }
  },
  "keywords": [
    "three.js",
    "viewport",
    "gizmo",
    "helper",
    "3d",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/three-viewport-gizmo.git"
  },
  "bugs": {
    "url": "https://github.com/taucad/three-viewport-gizmo/issues"
  },
  "homepage": "https://github.com/taucad/three-viewport-gizmo#readme",
  "allowScripts": {
    "esbuild@0.25.0": true,
    "nx@23.3.2": true,
    "fsevents@2.3.3": true
  }
}
